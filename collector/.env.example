# Sao chép thành collector/.env rồi sửa nếu cần. Không đặt thì dùng giá trị mặc định trong app/config.py.

# Để trống: chạy trên máy host tự dùng localhost:9092,9094,9096; trong Docker tự dùng kafka-N:29092
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096

# Máy nào có web The Sweets chạy cùng thì cổng 8000 đã bị mobile_backend chiếm, đổi sang 8010
# PORT=8000

# TOPIC_PREFIX=bakery
# DEDUP_CACHE_SIZE=50000
# MAX_FUTURE_SKEW_SECONDS=300
# LATE_THRESHOLD_SECONDS=3600
# MAX_BATCH_SIZE=5000
# DELIVERY_TIMEOUT_SECONDS=30
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Thí nghiệm cấu hình producer
# CRITICAL_ACKS=all
# CLICK_ACKS=1
# CLICK_LINGER_MS=20
# CLICK_BATCH_SIZE=131072
# COMPRESSION=lz4
